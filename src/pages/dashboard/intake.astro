---
import GoalAndConstraintsForm from "@/components/intake/GoalAndConstraintsForm";
import Layout from "@/layouts/Layout.astro";
import { readLatestTrainingIntake } from "@/lib/services/training-intakes";
import { readTrainingPlanForIntake } from "@/lib/services/training-plans";
import { createClient } from "@/lib/supabase";
import type { TrainingIntake } from "@/types";

const { user } = Astro.locals;

let latestEditableIntake: TrainingIntake | null = null;
let loadError: string | null = null;
let hasActivePlan = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (supabase && user) {
  try {
    const latestIntake = await readLatestTrainingIntake(supabase, user.id);
    if (latestIntake) {
      hasActivePlan = (await readTrainingPlanForIntake(supabase, user.id, latestIntake.id)) !== null;
      latestEditableIntake = hasActivePlan ? null : latestIntake;
    }
  } catch {
    loadError = "Nie udało się wczytać bieżących danych. Odśwież stronę, aby spróbować ponownie.";
  }
}

const queryError = Astro.url.searchParams.get("error");
const safeQueryError =
  queryError && queryError.length <= 160 ? queryError : queryError ? "Coś poszło nie tak. Spróbuj ponownie." : null;
const serverError = safeQueryError ?? loadError;
---

<Layout title="Dane treningowe">
  <main class="bg-cosmic min-h-screen px-4 py-8 text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center gap-5">
      <a href="/dashboard" class="w-fit text-sm text-cyan-200 transition-colors hover:text-cyan-100 hover:underline">
        Wróć do panelu
      </a>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-8">
        <div class="mb-6">
          <p class="mb-2 text-sm text-blue-100/65">{user?.email}</p>
          <h1 class="text-3xl font-bold text-white">Dane treningowe</h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-blue-100/75">
            Podaj cel, poziom doświadczenia i ograniczenia, które powinny wpłynąć na Twój pierwszy plan treningowy.
          </p>
        </div>

        {
          loadError ? (
            <p role="alert" class="text-sm text-rose-200">
              {loadError}
            </p>
          ) : (
            <GoalAndConstraintsForm
              initialIntake={latestEditableIntake}
              serverError={serverError}
              hasActivePlan={hasActivePlan}
              client:load
            />
          )
        }
      </section>
    </div>
  </main>
</Layout>
