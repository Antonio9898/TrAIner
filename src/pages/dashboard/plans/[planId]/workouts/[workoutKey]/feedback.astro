---
import PostWorkoutFeedbackForm from "@/components/workouts/PostWorkoutFeedbackForm";
import Layout from "@/layouts/Layout.astro";
import { readWorkoutFeedbackPageContext, type WorkoutFeedbackPageContext } from "@/lib/services/workout-feedback";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

function decodeRouteParam(value: string | undefined): string | null {
  if (value === undefined) return null;

  try {
    return decodeURIComponent(value);
  } catch {
    return null;
  }
}

const planId = decodeRouteParam(Astro.params.planId);
const workoutKey = decodeRouteParam(Astro.params.workoutKey);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let feedbackContext: WorkoutFeedbackPageContext | null = null;
let loadFailed = false;

if (supabase && user && planId && workoutKey) {
  try {
    feedbackContext = await readWorkoutFeedbackPageContext(supabase, user.id, { planId, workoutKey });
  } catch {
    loadFailed = true;
  }
} else {
  loadFailed = true;
}

const isAvailable = feedbackContext && feedbackContext.state !== "unavailable";
const canSubmit = feedbackContext?.state === "accepted-current";
const workoutLabel = feedbackContext?.currentWorkout?.label ?? feedbackContext?.history[0]?.workoutLabel ?? "Workout";
const formAction =
  planId && workoutKey
    ? `/api/training-plans/${encodeURIComponent(planId)}/workouts/${encodeURIComponent(workoutKey)}/feedback`
    : "";
const feedbackAction = Astro.url.searchParams.get("feedbackAction");
const feedbackError = Astro.url.searchParams.get("feedbackError");
const feedbackErrorMessages: Record<string, string> = {
  "invalid-request": "We could not validate that feedback. Check the fields and try again.",
  unavailable: "Feedback cannot be saved for this workout right now.",
  "token-conflict": "This form was already used with different feedback. Refresh the page and try again.",
  "save-failed": "We could not save your feedback. Your entry was not added.",
};
const successMessage = feedbackAction === "saved" ? "Workout feedback saved." : null;
const errorMessage = feedbackError
  ? (feedbackErrorMessages[feedbackError] ?? "We could not complete that feedback action. Please try again.")
  : feedbackAction && feedbackAction !== "saved"
    ? "We could not confirm that feedback action. Please try again."
    : null;

function formatCalendarDate(value: string): string {
  const calendarDate = value.slice(0, 10);
  return new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" }).format(
    new Date(`${calendarDate}T00:00:00.000Z`),
  );
}
---

<Layout title={`${workoutLabel} feedback`}>
  <main class="bg-cosmic min-h-screen px-4 py-8 text-white">
    <div class="mx-auto w-full max-w-5xl space-y-5">
      <header class="rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
        <a
          href="/dashboard"
          class="inline-flex rounded-md text-sm font-semibold text-cyan-100 transition-colors hover:text-cyan-50 focus-visible:ring-2 focus-visible:ring-cyan-200 focus-visible:outline-none"
        >
          ← Back to dashboard
        </a>
        <p class="mt-5 text-sm text-blue-100/65">Post-workout feedback</p>
        <h1 class="mt-1 text-2xl font-semibold break-words text-white sm:text-3xl">{workoutLabel}</h1>
        {
          isAvailable && feedbackContext && (
            <p class="mt-2 text-sm leading-6 break-words text-blue-100/75">
              {feedbackContext.plan.status === "accepted" ? "Accepted training plan" : "Plan under review"} · Recent
              entries for this workout
            </p>
          )
        }
      </header>

      {
        successMessage && (
          <p
            class="rounded-lg border border-emerald-300/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-50"
            role="status"
          >
            {successMessage}
          </p>
        )
      }

      {
        errorMessage && (
          <p class="rounded-lg border border-rose-300/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-50" role="alert">
            {errorMessage}
          </p>
        )
      }

      {
        !isAvailable || !feedbackContext ? (
          <section class="rounded-lg border border-amber-300/30 bg-amber-300/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
            <h2 class="text-xl font-semibold text-amber-50">Feedback unavailable</h2>
            <p class="mt-2 text-sm leading-6 text-amber-50/90">
              We could not find feedback you can view for this workout. Return to the dashboard and open a current
              accepted workout.
            </p>
            {loadFailed && <span class="sr-only">The feedback context could not be loaded.</span>}
          </section>
        ) : (
          <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)]">
            <section
              id="feedback-history"
              class="min-w-0 rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6"
            >
              <p class="text-sm text-blue-100/65">Append-only record</p>
              <h2 class="mt-1 text-xl font-semibold text-white">Recent feedback</h2>
              <p class="mt-2 text-sm leading-6 text-blue-100/70">Up to the 50 newest entries are shown.</p>

              {feedbackContext.history.length > 0 ? (
                <ol class="mt-5 space-y-4">
                  {feedbackContext.history.map((entry) => (
                    <li class="min-w-0 rounded-lg border border-white/10 bg-slate-950/20 p-4">
                      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                        <div class="min-w-0">
                          <p class="text-xs font-semibold text-cyan-100/70 uppercase">Completed workout</p>
                          <h3 class="mt-1 font-semibold break-words text-white">
                            {entry.workoutLabel ?? "Previous workout"}
                          </h3>
                        </div>
                        <time
                          datetime={entry.performedAt.slice(0, 10)}
                          class="shrink-0 text-sm font-medium text-blue-100/80"
                        >
                          {formatCalendarDate(entry.performedAt)}
                        </time>
                      </div>
                      <dl class="mt-4 grid gap-3 sm:grid-cols-2">
                        <div class="rounded-lg border border-white/10 bg-white/5 px-3 py-2">
                          <dt class="text-xs font-semibold text-blue-100/55 uppercase">Difficulty</dt>
                          <dd class="mt-1 text-sm text-white">{entry.difficultyRating} / 10</dd>
                        </div>
                        {entry.satisfactionRating !== null && (
                          <div class="rounded-lg border border-white/10 bg-white/5 px-3 py-2">
                            <dt class="text-xs font-semibold text-blue-100/55 uppercase">Satisfaction</dt>
                            <dd class="mt-1 text-sm text-white">{entry.satisfactionRating} / 5</dd>
                          </div>
                        )}
                      </dl>
                      {entry.notes && (
                        <div class="mt-3">
                          <p class="text-xs font-semibold text-blue-100/55 uppercase">Notes</p>
                          <p class="mt-1 text-sm leading-6 break-words whitespace-pre-wrap text-blue-50/90">
                            {entry.notes}
                          </p>
                        </div>
                      )}
                    </li>
                  ))}
                </ol>
              ) : (
                <div class="mt-5 rounded-lg border border-dashed border-white/20 bg-white/5 px-4 py-8 text-center">
                  <h3 class="font-semibold text-white">No feedback yet</h3>
                  <p class="mt-2 text-sm leading-6 text-blue-100/70">
                    Your completed-workout entries will appear here newest first.
                  </p>
                </div>
              )}

              {feedbackContext.currentWorkout && feedbackContext.history.length > 0 && (
                <p class="mt-5 rounded-lg border border-blue-200/20 bg-blue-300/10 px-4 py-3 text-sm leading-6 text-blue-50/85">
                  This plan may have been revised since earlier entries were recorded. Older feedback can describe an
                  earlier version of this workout, even when the workout key stayed the same.
                </p>
              )}
            </section>

            <aside class="min-w-0 space-y-5">
              {canSubmit && feedbackContext.plan.status === "accepted" && feedbackContext.currentWorkout ? (
                <section class="rounded-lg border border-cyan-200/20 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
                  <p class="text-sm text-cyan-100/70">Completed this workout?</p>
                  <h2 class="mt-1 text-xl font-semibold break-words text-white">Log how it went</h2>
                  <p class="mt-2 text-sm leading-6 text-blue-100/70">
                    Difficulty is required. Satisfaction and notes are optional.
                  </p>
                  <div class="mt-5">
                    <PostWorkoutFeedbackForm
                      client:only="react"
                      action={formAction}
                      acceptedAt={feedbackContext.plan.acceptedAt}
                      submissionToken={crypto.randomUUID()}
                    />
                  </div>
                </section>
              ) : (
                <section class="rounded-lg border border-amber-300/30 bg-amber-300/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
                  <h2 class="text-lg font-semibold text-amber-50">History is read-only</h2>
                  <p class="mt-2 text-sm leading-6 text-amber-50/90">
                    {feedbackContext.state === "draft-current"
                      ? "This plan is under review. Accept the current draft before logging another completed workout."
                      : "This workout is no longer in the current plan. Its earlier feedback is preserved, but new entries are unavailable."}
                  </p>
                </section>
              )}
            </aside>
          </div>
        )
      }
    </div>
  </main>
</Layout>
