---
import PlanGenerationForm from "@/components/plans/PlanGenerationForm";
import PlanRevisionForm from "@/components/plans/PlanRevisionForm";
import Layout from "@/layouts/Layout.astro";
import { isTrainingIntakeEditable, readLatestTrainingIntake } from "@/lib/services/training-intakes";
import { readTrainingPlanForIntake } from "@/lib/services/training-plans";
import { createClient } from "@/lib/supabase";
import type { TrainingExperienceLevel, TrainingPlan, TrainingPlanExerciseEntry, TrainingIntake } from "@/types";

const { user } = Astro.locals;

const experienceLabels: Record<TrainingExperienceLevel, string> = {
  beginner: "Początkujący",
  intermediate: "Średniozaawansowany",
  advanced: "Zaawansowany",
};

let latestIntake: TrainingIntake | null = null;
let latestIntakeEditable = false;
let storedPlan: TrainingPlan | null = null;
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (supabase && user) {
  try {
    latestIntake = await readLatestTrainingIntake(supabase, user.id);
    if (latestIntake) {
      storedPlan = await readTrainingPlanForIntake(supabase, user.id, latestIntake.id);
      latestIntakeEditable = storedPlan ? false : await isTrainingIntakeEditable(supabase, user.id, latestIntake.id);
    }
  } catch {
    loadError = "Nie udało się wczytać podsumowania panelu.";
  }
} else if (!supabase) {
  loadError = "Supabase nie jest skonfigurowany, więc nie można wczytać podsumowania danych.";
}

const savedIntake = Astro.url.searchParams.get("saved") === "intake";
const legacyGeneratedPlan = Astro.url.searchParams.get("generated") === "plan";
const legacyGenerationError = Astro.url.searchParams.get("error");
const planAction = Astro.url.searchParams.get("planAction") ?? (legacyGeneratedPlan ? "generated" : null);
const planErrorCode = Astro.url.searchParams.get("planError") ?? legacyGenerationError;
const planActionMessages: Record<string, string> = {
  generated: storedPlan
    ? "Plan został wygenerowany. Szkic znajdziesz poniżej."
    : "Generowanie planu zakończono. Odśwież panel, jeśli szkic nie jest widoczny.",
  revised: "Plan został zmieniony. Przejrzyj kompletny szkic przed zaakceptowaniem.",
  accepted: "Plan został zaakceptowany. To plan, który zamierzasz realizować.",
};
const planErrorMessages: Record<string, string> = {
  "request-not-allowed": "Nie udało się zweryfikować żądania. Spróbuj ponownie z panelu.",
  "supabase-not-configured": "Operacje na planie są niedostępne, ponieważ Supabase nie jest skonfigurowany.",
  "signin-required": "Zaloguj się przed zmianą planu.",
  "missing-intake": "Zapisz dane przed wygenerowaniem planu.",
  "stale-intake": "Te dane są już nieaktualne. Otwórz aktualny panel, aby kontynuować.",
  "intake-already-planned": "Dla tych danych istnieje już plan.",
  "openrouter-not-configured": "Generowanie planu nie jest jeszcze skonfigurowane.",
  "generation-timeout": "Przekroczono czas oczekiwania na AI. Spróbuj ponownie.",
  "operation-timeout": "Przekroczono czas oczekiwania. Ta próba nie rozpoczęła zapisu planu. Spróbuj ponownie.",
  "dependency-unavailable": "Usługa jest chwilowo niedostępna. Spróbuj ponownie później.",
  "outcome-unknown":
    "Nie udało się potwierdzić wyniku. Plan mógł zostać zapisany. Sprawdź aktualny plan przed ponowieniem.",
  "invalid-generation": "Nie udało się wygenerować poprawnego planu. Spróbuj ponownie.",
  "invalid-request": "Żądanie planu było niepoprawne. Odśwież panel i spróbuj ponownie.",
  "invalid-revision": "Nie udało się utworzyć poprawionej wersji planu. Obecny plan nie został zmieniony.",
  "plan-conflict": "Plan zmienił się w innej karcie. Odśwież panel i spróbuj ponownie.",
  "save-failed": "Nie udało się potwierdzić zapisu zmiany. Sprawdź aktualny plan przed ponowieniem.",
};
const planError = planErrorCode
  ? (planErrorMessages[planErrorCode] ?? "Nie udało się wykonać tej operacji na planie. Spróbuj ponownie.")
  : planAction && !planActionMessages[planAction]
    ? "Nie udało się potwierdzić tej operacji na planie. Spróbuj ponownie."
    : null;
const planSuccess = planAction && planActionMessages[planAction] ? planActionMessages[planAction] : null;
const updatedAt = latestIntake
  ? new Intl.DateTimeFormat("pl-PL", {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(latestIntake.updatedAt))
  : null;

const intakeLinkLabel = latestIntake ? (latestIntakeEditable ? "Edytuj dane" : "+ Nowy plan") : "Dodaj dane";

function formatPlanDate(value: string): string {
  return new Intl.DateTimeFormat("pl-PL", {
    dateStyle: "medium",
  }).format(new Date(value));
}

function formatPlanDateTime(value: string): string {
  return new Intl.DateTimeFormat("pl-PL", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(value));
}

function formatExerciseDetails(exercise: TrainingPlanExerciseEntry): string[] {
  const details: string[] = [];

  if (exercise.sets) {
    details.push(`${exercise.sets} serii`);
  }

  if (exercise.reps) {
    details.push(exercise.reps);
  }

  if (exercise.loadGuidance) {
    details.push(exercise.loadGuidance);
  }

  if (exercise.restSeconds !== undefined) {
    details.push(`${exercise.restSeconds} s przerwy`);
  }

  return details;
}
---

<Layout title="Panel główny">
  <main class="bg-cosmic min-h-screen px-4 py-8 text-white">
    <div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col justify-center gap-5">
      <header
        class="flex flex-col gap-4 rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <p class="text-sm text-blue-100/65">Zalogowano jako</p>
          <h1 class="mt-1 text-2xl font-semibold break-words text-white">{user?.email}</h1>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/dashboard/intake"
            class="rounded-lg bg-cyan-300 px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-200"
          >
            {intakeLinkLabel}
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
            >
              Wyloguj się
            </button>
          </form>
        </div>
      </header>

      {
        savedIntake && (
          <p class="rounded-lg border border-emerald-300/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-50">
            Dane zostały zapisane. Podsumowanie w panelu zostało zaktualizowane.
          </p>
        )
      }

      {
        planSuccess && (
          <p
            class="rounded-lg border border-emerald-300/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-50"
            role="status"
          >
            {planSuccess}
          </p>
        )
      }

      {
        planError && (
          <p class="rounded-lg border border-rose-300/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-50" role="alert">
            {planError}
          </p>
        )
      }

      {
        loadError && (
          <p class="rounded-lg border border-amber-300/30 bg-amber-300/10 px-4 py-3 text-sm text-amber-50">
            {loadError}
          </p>
        )
      }

      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="space-y-5">
          {
            storedPlan ? (
              <section class="rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
                <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <p class="text-sm text-blue-100/65">
                      {storedPlan.status === "accepted" ? "Zaakceptowany plan" : "Plan do sprawdzenia"}
                    </p>
                    <h2 class="mt-1 text-2xl font-semibold text-white">
                      {storedPlan.status === "accepted"
                        ? "Zaakceptowany plan treningowy"
                        : storedPlan.revisionCount > 0
                          ? "Zmieniony szkic planu"
                          : "Pierwszy plan z wyjaśnieniem"}
                    </h2>
                    <p class="mt-2 text-sm leading-6 break-words text-blue-100/75">
                      Utworzono: {formatPlanDate(storedPlan.createdAt)} · Zaktualizowano:{" "}
                      {formatPlanDateTime(storedPlan.updatedAt)}
                    </p>
                    <p class="mt-1 text-sm leading-6 break-words text-blue-100/75">
                      {storedPlan.revisionCount === 0
                        ? "Wersja oryginalna"
                        : `${storedPlan.revisionCount} ${storedPlan.revisionCount === 1 ? "pełna zmiana" : "pełne zmiany"}`}
                      {storedPlan.lastRevisionRequestedAt &&
                        ` · Ostatnia zmiana: ${formatPlanDateTime(storedPlan.lastRevisionRequestedAt)}`}
                    </p>
                  </div>
                  <p
                    class:list={[
                      "w-fit rounded-full border px-3 py-1 text-xs font-semibold uppercase",
                      storedPlan.status === "accepted"
                        ? "border-emerald-200/30 bg-emerald-300/10 text-emerald-50"
                        : "border-cyan-200/30 bg-cyan-300/10 text-cyan-50",
                    ]}
                  >
                    {storedPlan.status}
                  </p>
                </div>

                <div class="space-y-6">
                  <details
                    class="group rounded-lg border border-cyan-200/20 bg-slate-950/20 p-4 sm:p-5"
                    open={Boolean(planError)}
                  >
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md focus-visible:ring-2 focus-visible:ring-cyan-200 focus-visible:outline-none [&::-webkit-details-marker]:hidden">
                      <span>
                        <span class="block text-xs font-semibold text-cyan-100/70 uppercase">Ocena planu</span>
                        <span class="mt-1 block text-xl font-semibold text-white">Zmień lub zaakceptuj plan</span>
                      </span>
                      <span
                        class="shrink-0 text-xl text-cyan-100 transition-transform group-open:rotate-180"
                        aria-hidden="true"
                      >
                        ⌄
                      </span>
                    </summary>

                    <div class="mt-5">
                      <p class="mb-5 text-sm leading-6 break-words text-blue-100/75">
                        Poniżej opisz oczekiwaną zmianę. Zaakceptuj szkic tylko wtedy, gdy jest to wersja, którą
                        zamierzasz realizować; akceptacja nie jest zgodą medyczną ani gwarancją bezpieczeństwa.
                      </p>

                      <div class="grid gap-5 xl:grid-cols-2">
                        <div class="rounded-lg border border-white/10 bg-white/5 p-4">
                          <h3 class="text-base font-semibold text-white">Poproś o zmianę</h3>
                          <p class="mt-1 text-sm leading-6 text-blue-100/70">
                            Opisz jedną zmianę i sprawdź ograniczenia zdrowotne użyte przy aktualizacji planu.
                          </p>
                          <div class="mt-4">
                            <PlanRevisionForm
                              client:load
                              planId={storedPlan.id}
                              expectedUpdatedAt={storedPlan.updatedAt}
                              initialHealthConstraints={latestIntake?.healthConstraints ?? ""}
                              accepted={storedPlan.status === "accepted"}
                            />
                          </div>
                        </div>

                        <div class="h-fit rounded-lg border border-white/10 bg-white/5 p-4">
                          {storedPlan.status === "draft" ? (
                            <form
                              method="POST"
                              action="/api/training-plans/accept"
                              class="space-y-4"
                              data-plan-native-form
                            >
                              <input type="hidden" name="planId" value={storedPlan.id} />
                              <input type="hidden" name="expectedUpdatedAt" value={storedPlan.updatedAt} />
                              <div>
                                <h3 class="text-base font-semibold text-white">Zaakceptuj szkic</h3>
                                <p class="mt-1 text-sm leading-6 break-words text-blue-100/70">
                                  Oznacz sprawdzoną wersję jako plan, który zamierzasz realizować. Nadal możesz później
                                  poprosić o zmianę, która ponownie otworzy go jako szkic.
                                </p>
                              </div>
                              <button
                                type="submit"
                                data-plan-submit
                                data-loading-label="Akceptowanie planu..."
                                class="w-full rounded-lg bg-emerald-300 px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-100 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-70"
                              >
                                Zaakceptuj plan
                              </button>
                            </form>
                          ) : (
                            <div>
                              <h3 class="text-base font-semibold text-white">Plan zaakceptowany</h3>
                              <p class="mt-1 text-sm leading-6 break-words text-blue-100/70">
                                Zaakceptowano: {formatPlanDateTime(storedPlan.acceptedAt)}. To zapis wersji, którą
                                zamierzasz realizować; nie gwarantuje bezpieczeństwa ani nie zastępuje porady
                                specjalisty.
                              </p>
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  </details>

                  {storedPlan.lastRevisionNote && (
                    <section class="rounded-lg border border-cyan-200/20 bg-cyan-300/10 px-4 py-3">
                      <p class="text-xs font-semibold text-cyan-50/75 uppercase">Ostatnia prośba o zmianę</p>
                      <p class="mt-1 text-sm leading-6 break-words whitespace-pre-wrap text-cyan-50/90">
                        {storedPlan.lastRevisionNote}
                      </p>
                    </section>
                  )}
                  {storedPlan.status === "draft" && storedPlan.lastRevisionSummary && (
                    <section class="rounded-lg border border-amber-300/25 bg-amber-300/10 px-4 py-3">
                      <p class="text-xs font-semibold text-amber-50/80 uppercase">Co się zmieniło</p>
                      <p class="mt-1 text-sm leading-6 break-words whitespace-pre-wrap text-amber-50/90">
                        {storedPlan.lastRevisionSummary}
                      </p>
                    </section>
                  )}
                  <section class="space-y-2">
                    <p class="text-xs font-semibold text-blue-100/50 uppercase">Dlaczego ten plan</p>
                    <p class="text-sm leading-6 break-words whitespace-pre-wrap text-blue-50/90">
                      {storedPlan.explanation}
                    </p>
                  </section>

                  <section class="space-y-2">
                    <p class="text-xs font-semibold text-blue-100/50 uppercase">Przegląd</p>
                    <p class="text-sm leading-6 break-words whitespace-pre-wrap text-blue-50/90">
                      {storedPlan.planContent.overview}
                    </p>
                  </section>

                  <section class="space-y-4">
                    <div>
                      <p class="text-xs font-semibold text-blue-100/50 uppercase">Zaplanowane treningi</p>
                      <h3 class="mt-1 text-lg font-semibold text-white">Ten tydzień</h3>
                    </div>
                    <div class="space-y-4">
                      {storedPlan.planContent.scheduledWorkouts.map((workout, workoutIndex) => (
                        <article class="rounded-lg border border-white/10 bg-white/5 p-4">
                          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                              <p class="text-xs font-semibold text-cyan-100/70 uppercase">Trening {workoutIndex + 1}</p>
                              <h4 class="mt-1 text-base font-semibold break-words text-white">{workout.label}</h4>
                              {workout.focus && (
                                <p class="mt-1 text-sm leading-6 break-words whitespace-pre-wrap text-blue-100/75">
                                  {workout.focus}
                                </p>
                              )}
                            </div>
                            {storedPlan.status === "accepted" && (
                              <a
                                href={`/dashboard/plans/${encodeURIComponent(storedPlan.id)}/workouts/${encodeURIComponent(workout.key)}/feedback`}
                                class="inline-flex w-fit shrink-0 rounded-lg border border-cyan-200/30 bg-cyan-300/10 px-3 py-2 text-sm font-semibold text-cyan-50 transition-colors hover:bg-cyan-300/20 focus-visible:ring-2 focus-visible:ring-cyan-200 focus-visible:outline-none"
                              >
                                Zapisz wykonany trening
                              </a>
                            )}
                          </div>

                          <ol class="mt-4 space-y-3">
                            {workout.exercises.map((exercise, exerciseIndex) => {
                              const details = formatExerciseDetails(exercise);

                              return (
                                <li class="rounded-lg border border-white/10 bg-slate-950/20 p-3">
                                  <div class="flex gap-3">
                                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-cyan-300 text-xs font-semibold text-slate-950">
                                      {exerciseIndex + 1}
                                    </span>
                                    <div class="min-w-0 flex-1">
                                      <p class="text-sm font-semibold break-words text-white">{exercise.name}</p>
                                      {details.length > 0 && (
                                        <p class="mt-1 text-sm leading-6 break-words text-blue-100/75">
                                          {details.join(" / ")}
                                        </p>
                                      )}
                                      {exercise.notes && (
                                        <p class="mt-2 text-sm leading-6 break-words whitespace-pre-wrap text-blue-50/85">
                                          {exercise.notes}
                                        </p>
                                      )}
                                    </div>
                                  </div>
                                </li>
                              );
                            })}
                          </ol>

                          {workout.instructions && (
                            <div class="mt-4 rounded-lg border border-white/10 bg-white/5 px-3 py-2">
                              <p class="text-xs font-semibold text-blue-100/50 uppercase">Instrukcje</p>
                              <p class="mt-1 text-sm leading-6 break-words whitespace-pre-wrap text-blue-50/85">
                                {workout.instructions}
                              </p>
                            </div>
                          )}

                          {workout.safetyNotes && workout.safetyNotes.length > 0 && (
                            <div class="mt-4 rounded-lg border border-amber-300/25 bg-amber-300/10 px-3 py-2">
                              <p class="text-xs font-semibold text-amber-50/80 uppercase">
                                Uwagi dotyczące bezpieczeństwa
                              </p>
                              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6 text-amber-50">
                                {workout.safetyNotes.map((note) => (
                                  <li class="break-words whitespace-pre-wrap">{note}</li>
                                ))}
                              </ul>
                            </div>
                          )}
                        </article>
                      ))}
                    </div>
                  </section>

                  <section class="space-y-2">
                    <p class="text-xs font-semibold text-blue-100/50 uppercase">Progresja</p>
                    <p class="text-sm leading-6 break-words whitespace-pre-wrap text-blue-50/90">
                      {storedPlan.planContent.progressionGuidance}
                    </p>
                  </section>

                  <section class="rounded-lg border border-amber-300/25 bg-amber-300/10 px-4 py-3">
                    <p class="text-xs font-semibold text-amber-50/80 uppercase">Uwagi dotyczące bezpieczeństwa planu</p>
                    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6 text-amber-50">
                      {storedPlan.planContent.safetyNotes.map((note) => (
                        <li class="break-words whitespace-pre-wrap">{note}</li>
                      ))}
                    </ul>
                    <p class="mt-3 text-sm leading-6 break-words text-amber-50/90">
                      TrAIner nie diagnozuje urazów ani nie zastępuje porady lekarza, fizjoterapeuty lub trenera
                      medycznego. Jeśli odczuwasz ból, masz objawy, chorobę lub wątpliwości dotyczące treningu,
                      skonsultuj się z wykwalifikowanym specjalistą.
                    </p>
                  </section>
                </div>
              </section>
            ) : (
              <section class="rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
                <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <p class="text-sm text-blue-100/65">Dane do planu</p>
                    <h2 class="mt-1 text-xl font-semibold text-white">Cel i ograniczenia</h2>
                  </div>
                  <a
                    href="/dashboard/intake"
                    class="w-fit rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm font-medium text-cyan-100 transition-colors hover:bg-white/20"
                  >
                    {intakeLinkLabel}
                  </a>
                </div>

                {latestIntake ? (
                  <div class="space-y-4">
                    <div>
                      <p class="text-xs font-semibold text-blue-100/50 uppercase">Cel</p>
                      <p class="mt-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm leading-6 break-words whitespace-pre-wrap text-white">
                        {latestIntake.goal}
                      </p>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <div>
                        <p class="text-xs font-semibold text-blue-100/50 uppercase">Poziom doświadczenia</p>
                        <p class="mt-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm leading-6 break-words whitespace-pre-wrap text-white">
                          {experienceLabels[latestIntake.experienceLevel]}
                        </p>
                      </div>
                      {updatedAt && (
                        <div>
                          <p class="text-xs font-semibold text-blue-100/50 uppercase">Ostatnia aktualizacja</p>
                          <p class="mt-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm leading-6 break-words whitespace-pre-wrap text-white">
                            {updatedAt}
                          </p>
                        </div>
                      )}
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-blue-100/50 uppercase">Ograniczenia zdrowotne</p>
                      <p class="mt-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm leading-6 break-words whitespace-pre-wrap text-white">
                        {latestIntake.healthConstraints}
                      </p>
                    </div>
                    {latestIntake.notes && (
                      <div>
                        <p class="text-xs font-semibold text-blue-100/50 uppercase">Dodatkowe uwagi</p>
                        <p class="mt-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm leading-6 break-words whitespace-pre-wrap text-white">
                          {latestIntake.notes}
                        </p>
                      </div>
                    )}
                    <p class="rounded-lg border border-blue-200/15 bg-blue-300/10 px-3 py-2 text-sm leading-6 text-blue-50/80">
                      {latestIntakeEditable
                        ? "Te dane można jeszcze edytować przed wygenerowaniem pierwszego planu."
                        : "Te dane są już powiązane z planem. Nowe zgłoszenie utworzy nowy zestaw danych."}
                    </p>
                  </div>
                ) : (
                  <div class="rounded-lg border border-dashed border-white/20 bg-white/5 px-4 py-8 text-center">
                    <h3 class="text-lg font-semibold text-white">Nie zapisano jeszcze danych</h3>
                    <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-blue-100/70">
                      Dodaj cel treningowy, poziom doświadczenia, ograniczenia zdrowotne i dodatkowe uwagi, aby TrAIner
                      mógł przygotować pierwszy plan z wyjaśnieniem.
                    </p>
                    <a
                      href="/dashboard/intake"
                      class="mt-5 inline-flex rounded-lg bg-cyan-300 px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-200"
                    >
                      Dodaj dane
                    </a>
                  </div>
                )}
              </section>
            )
          }
        </div>

        <aside class="space-y-5">
          {
            storedPlan && latestIntake ? (
              <section class="rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
                <p class="text-sm text-blue-100/65">Źródło planu</p>
                <h2 class="mt-1 text-xl font-semibold text-white">Najnowsze dane</h2>
                <div class="mt-4 space-y-4">
                  <div>
                    <p class="text-xs font-semibold text-blue-100/50 uppercase">Cel</p>
                    <p class="mt-1 text-sm leading-6 break-words whitespace-pre-wrap text-white">{latestIntake.goal}</p>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-blue-100/50 uppercase">Doświadczenie</p>
                    <p class="mt-1 text-sm leading-6 text-white">{experienceLabels[latestIntake.experienceLevel]}</p>
                  </div>
                  <p class="rounded-lg border border-blue-200/15 bg-blue-300/10 px-3 py-2 text-sm leading-6 text-blue-50/80">
                    Te dane kształtują obecny plan ({storedPlan.status === "accepted" ? "zaakceptowany" : "szkic"}).
                    Aktualizuj ograniczenia zdrowotne w formularzu zmiany, aby plan i dane źródłowe pozostały spójne.
                  </p>
                  <a
                    href="/dashboard/intake"
                    class="inline-flex rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm font-medium text-cyan-100 transition-colors hover:bg-white/20"
                  >
                    + Nowy plan
                  </a>
                </div>
              </section>
            ) : (
              <section class="rounded-lg border border-white/10 bg-white/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
                <p class="text-sm text-blue-100/65">Następny krok</p>
                <h2 class="mt-1 text-xl font-semibold text-white">Pierwszy plan z wyjaśnieniem</h2>
                {latestIntake && latestIntakeEditable ? (
                  <PlanGenerationForm client:load intakeId={latestIntake.id} />
                ) : (
                  <p class="mt-3 text-sm leading-6 break-words text-blue-100/75">
                    Zapisz edytowalne dane przed wygenerowaniem pierwszego planu z wyjaśnieniem.
                  </p>
                )}
              </section>
            )
          }

          <section class="rounded-lg border border-amber-300/30 bg-amber-300/10 p-5 shadow-2xl backdrop-blur-xl sm:p-6">
            <p class="text-sm font-semibold text-amber-50">Granice działania aplikacji</p>
            <p class="mt-2 text-sm leading-6 break-words text-amber-50/90">
              TrAIner może pomóc dostosować plan do podanych ograniczeń, ale nie diagnozuje urazów ani nie zastępuje
              porady lekarza, fizjoterapeuty lub trenera medycznego.
            </p>
          </section>
        </aside>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll("[data-plan-native-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      const button = form.querySelector("[data-plan-submit]");

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = button.dataset.loadingLabel || "Generowanie...";
      }
    });
  });
</script>
